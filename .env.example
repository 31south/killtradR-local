# BloFin (real or demo)
BLOFIN_API_KEY=
BLOFIN_SECRET=
BLOFIN_PASSPHRASE=
USE_DEMO=true

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=deepseek-coder

# Trading
SYMBOL=BTC-USDT
RISK_PCT_PER_TRADE=0.5
MAX_CONCURRENT_POSITIONS=2
MAX_DAILY_LOSS_PCT=3.0
TRADE_ENABLED=false

# Detection
DETECTOR_CONFIDENCE_THRESHOLD=0.75
LIQUIDITY_GRAB_LOOKBACK_BARS=50
STOP_HUNT_RETRACE_WINDOW_SEC=30

# Cross-reference
CHOKE_THRESHOLD_MS=500
BINANCE_SYMBOL=BTC/USDT:USDT

# Binance COIN-M (Delivery Futures) WebSocket — liquidation + agg trade feed
BINANCE_COINM_WS_URL=wss://dstream.binance.com/ws
BINANCE_COINM_SYMBOL=btcusd_perp
BINANCE_COINM_CONTRACT_VALUE_USD=100
COINM_SPREAD_ALERT_BPS=50

# Liquidation cascade detector
LIQUIDATION_CASCADE_WINDOW_SEC=60
LIQUIDATION_CASCADE_USD_THRESHOLD=5000000
LIQUIDATION_CASCADE_COUNT_THRESHOLD=20
LIQUIDATION_CASCADE_DIRECTIONAL_BIAS=0.70

# UI
VERBOSE=false
LOG_LEVEL=INFO

# Signal journal
JOURNAL_ENABLED=true
JOURNAL_PATH=./killtrader.journal.db
JOURNAL_ALL_TRIGGERS=false
JOURNAL_FLUSH_EVERY_N=50
JOURNAL_FLUSH_EVERY_SEC=5
PAPER_POSITION_TIMEOUT_SEC=3600
